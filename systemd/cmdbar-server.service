[Unit]
Description=CmdBar Headless Server Mode Service
Documentation=https://github.com/grootmax/CmdBar
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/env python3 -m companion.server --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5s
Environment=PYTHONUNBUFFERED=1
Environment=CMDBAR_CONFIG_PATH=%h/.config/cmdbar/config.json

# Security hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=%h/.config/cmdbar

[Install]
WantedBy=default.target

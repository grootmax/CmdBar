{
  "audit": {
    "enabled": true,
    "privacy_mode": false,
    "sensitive_keywords": [
      "password",
      "passwd",
      "secret",
      "token",
      "api_key",
      "apikey",
      "key",
      "credentials",
      "cred",
      "sudo",
      "auth",
      "bearer",
      "private_key"
    ]
  },
  "profiles": [
    {
      "name": "Production",
      "env": {
        "ENV": "production",
        "LOG_LEVEL": "warn"
      }
    },
    {
      "name": "Staging",
      "env": {
        "ENV": "staging",
        "LOG_LEVEL": "info"
      }
    },
    {
      "name": "Development",
      "env": {
        "ENV": "development",
        "LOG_LEVEL": "debug"
      }
    }
  ],
  "active_profile": "Development",
  "midi": {
    "enabled": true,
    "performance_mode": false,
    "active_bank": "Bank 1",
    "active_deck": "Deck A",
    "led_feedback": true,
    "mappings": []
  },
  "categories": [
    {
      "name": "Projects",
      "commands": [
        {
          "name": "Run Dev Server",
          "command": ["npm", "run", "dev"]
        },
        {
          "name": "Docker Logs",
          "command": ["docker", "logs", "-f", "<container-id>"]
        }
      ]
    },
    {
      "name": "Infrastructure",
      "commands": [
        {
          "name": "Deploy Service",
          "command": [
            "ansible-playbook",
            "-i",
            "inventory",
            "deploy.yml",
            "--extra-vars",
            "service=<service-name> version=<version-tag>"
          ]
        },
        {
          "name": "Scale Deployment",
          "command": [
            "kubectl",
            "scale",
            "deployment/<deployment-name>",
            "--replicas=<replica-count>"
          ]
        }
      ]
    },
    {
      "name": "Git",
      "commands": [
        {
          "name": "Git Status",
          "command": ["git", "status"]
        },
        {
          "name": "Git Pull",
          "command": ["git", "pull", "origin", "{git-branch}"]
        },
        {
          "name": "Git Push",
          "command": ["git", "push", "origin", "{git-branch}"]
        },
        {
          "name": "Git Commit",
          "command": ["git", "commit", "-m", "<commit-message>"]
        }
      ]
    }
  ]
}

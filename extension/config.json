{
  "categories": [
    {
      "name": "Projects",
      "commands": [
        {
          "name": "Run Dev Server",
          "command": ["npm", "run", "dev"]
        },
        {
          "name": "Docker Logs",
          "command": ["docker", "logs", "-f", "<container-id>"]
        }
      ]
    },
    {
      "name": "Infrastructure",
      "commands": [
        {
          "name": "Deploy Service",
          "command": [
            "ansible-playbook",
            "-i",
            "inventory",
            "deploy.yml",
            "--extra-vars",
            "service=<service-name> version=<version-tag>"
          ]
        },
        {
          "name": "Scale Deployment",
          "command": [
            "kubectl",
            "scale",
            "deployment/<deployment-name>",
            "--replicas=<replica-count>"
          ]
        }
      ]
    },
    {
      "name": "Git",
      "commands": [
        {
          "name": "Git Status",
          "command": ["git", "status"]
        },
        {
          "name": "Git Pull",
          "command": ["git", "pull", "origin", "{git-branch}"]
        },
        {
          "name": "Git Push",
          "command": ["git", "push", "origin", "{git-branch}"]
        },
        {
          "name": "Git Commit",
          "command": ["git", "commit", "-m", "<commit-message>"]
        }
      ]
    }
  ]
}

{
  "midi": {
    "enabled": true,
    "performance_mode": false,
    "active_bank": "Bank 1",
    "active_deck": "Deck A",
    "led_feedback": true,
    "mappings": []
  },
  "categories": [
    {
      "name": "Projects",
      "commands": [
        {
          "name": "Run Dev Server",
          "command": ["npm", "run", "dev"]
        },
        {
          "name": "Docker Logs",
          "command": ["docker", "logs", "-f", "<container-id>"]
        }
      ]
    },
    {
      "name": "Infrastructure",
      "commands": [
        {
          "name": "Deploy Service",
          "command": [
            "ansible-playbook",
            "-i",
            "inventory",
            "deploy.yml",
            "--extra-vars",
            "service=<service-name> version=<version-tag>"
          ]
        },
        {
          "name": "Scale Deployment",
          "command": [
            "kubectl",
            "scale",
            "deployment/<deployment-name>",
            "--replicas=<replica-count>"
          ]
        }
      ]
    }
  ]
}
